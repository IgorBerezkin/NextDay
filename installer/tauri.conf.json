{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next Day Setup",
  "version": "0.4.0",
  "identifier": "ru.igorberezkin.nextday.setup",
  "build": {
    "frontendDist": "../dist-installer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
